        "jsCode": "const ticketId = 'TKT-' + Date.now();\nconst submittedAt = new Date().toISOString();\n\nreturn {\n  json: {\n    ...$input.first().json.body,\n    ticket_id: ticketId,\n    submitted_at: submittedAt\n  }\n};"

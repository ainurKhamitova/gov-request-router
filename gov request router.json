    {
      "parameters": {
        "jsCode": "const previousData = $('Generate Ticket ID').first().json;\nconst raw = $input.first().json.text || '';\n\nconst validCategories = [\n  'INFRASTRUCTURE', 'HEALTH', 'LICENSING',\n  'SOCIAL_SERVICES', 'EDUCATION', 'OTHER'\n];\nconst validPriorities = ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW'];\n\n// Split the response by pipe\nconst parts = raw.split('|');\nlet category = parts[0]?.trim();\nlet priority = parts[1]?.trim();\n\n// Fallback for category\nif (!validCategories.includes(category)) {\n  category = validCategories.find(c => raw.includes(c)) || 'OTHER';\n}\n\n// Fallback for priority\nif (!validPriorities.includes(priority)) {\n  priority = validPriorities.find(p => raw.includes(p)) || 'MEDIUM';\n}\n\nreturn {\n  json: {\n    ...previousData,\n    category: category,\n    priority: priority\n  }\n};"
      },
